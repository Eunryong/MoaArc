# MoaArc 환경변수 예시
# 실제 값은 .env 파일에 설정하세요 (Git에 커밋하지 마세요)

# ─── 온체인 (프론트엔드 + 서버 공통) ─────────────────────────────────────────
# Arc Studio RPC 프록시 (Arc Studio 샌드박스에서 자동 설정)
RPC_PROXY_BASE_URL=https://...
RPC_PROXY_TOKEN=...
RPC_PROXY_CHAINS=ARC-TESTNET,ETH-SEPOLIA,...

# ─── 네트워크 선택 (서버) ────────────────────────────────────────────────────
# 기본은 Arc Testnet 입니다. 아래 값이 잘못되면 서버는 write API 를 503 으로 막습니다 (fail-closed).
# MOARC_NETWORK 는 정확히 소문자 "testnet" 또는 "mainnet" 만 허용합니다 (VITE_NETWORK 와 동일).
# 대문자("Mainnet")·앞뒤 공백·오타·다른 값은 오류입니다. 미설정/빈 값/공백뿐인 값은 testnet 기본값입니다.
MOARC_NETWORK=testnet
# 10진 정수만 허용. testnet = 5042002 (생략 가능), mainnet = 5042 (필수)
MOARC_CHAIN_ID=5042002

# MoaArcTreasury 컨트랙트 주소 (0x...). mainnet 에서는 테스트넷 배포 주소를 거부합니다.
MOARC_CONTRACT_ADDRESS=0x...

# USDC 주소. testnet 은 생략 가능(기본 0x3600…0000). mainnet 은 필수이며 정확히 0x3600000000000000000000000000000000000000
# MOARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# 기대하는 VERSION() (mainnet 에서는 "MoaArc-3.0" 고정)
# MOARC_CONTRACT_VERSION=MoaArc-3.0

# ─── RPC (네트워크별 변수 — 서로 섞이지 않습니다) ─────────────────────────────────
# testnet 전용: ARC_TESTNET_RPC_URL(_2,_3), (기존 호환) ARC_RPC_URL(_2,_3), ARC_TESTNET_RPC_FALLBACK, RPC_PROXY_*
# 아무것도 없으면 viem 공식 Arc Testnet 기본 RPC 를 사용합니다.
ARC_TESTNET_RPC_FALLBACK=https://rpc.testnet.arc.io
# ARC_TESTNET_RPC_URL=https://...

# mainnet 전용 (https 필수): ARC_MAINNET_RPC_URL(_2,_3). 없으면 viem 공식 Arc Mainnet 기본 RPC.
# mainnet 에서는 ARC_TESTNET_RPC_FALLBACK, RPC_PROXY_*, 범용 ARC_RPC_URL* 를 사용하지 않습니다
# (범용 ARC_RPC_URL* 가 설정돼 있으면 오류). 서버는 시작 시 eth_chainId 가 5042 인지 확인합니다.
# ARC_MAINNET_RPC_URL=https://...

# ─── 서버 ─────────────────────────────────────────────────────────────────────
# SQLite 데이터베이스 파일 경로 (절대 경로 또는 프로세스 기준 상대 경로)
# 미설정 시 server/prisma/dev.db 사용 (bun:sqlite 직접 접근)
DATABASE_PATH=./server/prisma/dev.db

# JWT 서명 키 (랜덤 32바이트 이상 권장)
# 생성: openssl rand -base64 32
JWT_SECRET=change-me-in-production

# CORS 허용 origin (쉼표 구분)
ALLOWED_ORIGINS=http://localhost:5173

# API 서버 포트 (기본 3001)
# PORT=3001

# ─── Gemini 에이전트 ──────────────────────────────────────────────────────────
# Google AI Studio API 키 (https://aistudio.google.com)
# 주의: VITE_ 접두사 사용 금지 — 브라우저에 노출됩니다
GEMINI_API_KEY=your-key-here

# Gemini 모델 ID (기본: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# ─── 프론트엔드 (Vite) ─────────────────────────────────────────────────────────
# API 서버 URL (프론트엔드에서 fetch 시 사용)
# Hugging Face Spaces 배포 시 실제 서버 URL로 변경
VITE_API_BASE_URL=http://localhost:3001

# 네트워크 (빌드타임, 공개값만). 기본은 testnet 이며 서버의 MOARC_* 값과 반드시 일치해야 합니다.
# "testnet" 또는 "mainnet" 만 허용 — 오타·다른 값이면 모든 온체인 write 가 차단됩니다.
VITE_NETWORK=testnet
# VITE_CHAIN_ID=5042002
# VITE_CONTRACT_ADDRESS=0x...
# VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# VITE_CONTRACT_VERSION=MoaArc-3.0

# ─── Arc Mainnet 예시 (사용자가 직접 배포한 뒤에만 사용 — docs/MAINNET_DEPLOYMENT.md 참고) ───
# 아래는 자리표시자입니다. 컨트랙트 주소는 배포 후 사용자가 직접 채웁니다. 프리뷰/샌드박스에는 설정하지 마세요.
#   VITE_NETWORK=mainnet
#   VITE_CHAIN_ID=5042
#   VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000
#   VITE_CONTRACT_ADDRESS=<MAINNET_DEPLOYED_CONTRACT_ADDRESS>
#   MOARC_NETWORK=mainnet
#   MOARC_CHAIN_ID=5042
#   MOARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
#   MOARC_CONTRACT_ADDRESS=<MAINNET_DEPLOYED_CONTRACT_ADDRESS>
#   MOARC_CONTRACT_VERSION=MoaArc-3.0
#   ARC_MAINNET_RPC_URL=<YOUR_MAINNET_RPC_HTTPS_URL>
#   ALLOWED_ORIGINS=<YOUR_PRODUCTION_WEB_ORIGIN>
#   VITE_API_BASE_URL=<YOUR_PRODUCTION_API_URL>
